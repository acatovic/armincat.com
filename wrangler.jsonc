{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "armincat-com",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "armincat.com",
      "custom_domain": true
    }
  ]
}
